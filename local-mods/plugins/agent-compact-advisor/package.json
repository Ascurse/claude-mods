{
  "name": "agent-compact-advisor",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint hooks/model --max-warnings 0 --no-warn-ignored --no-error-on-unmatched-pattern && eslint . --ignore-pattern 'hooks/model/**' --max-warnings 0 && eslint --no-inline-config --config eslint/suppression-guard.ts . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "repo:lint": "knip && ls-lint",
    "validate": "claude plugin validate --strict . && claude plugin validate --strict .claude-plugin/plugin.json",
    "test": "claude plugin test .",
    "smoke:live": "sh scripts/live-smoke.sh",
    "eval": "claude plugin eval . --trust-plugin --no-publish --ablation none --model haiku",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run repo:lint && npm run validate && npm test",
    "update-types": "sh scripts/update-types.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.289",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
